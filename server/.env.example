GEMINI_API_KEY=

# Postgres (matches docker-compose.yml at repo root)
DATABASE_URL=postgresql://leadtriage:leadtriage@localhost:5432/leadtriage

USE_FAKES=1
DRY_RUN=0
FAST_MODEL=gemini-3.5-flash-lite
SMART_MODEL=gemini-3.8-flash
CRM_PROVIDER=hubspot

# Frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Fill in when wiring live integrations
# HubSpot private app scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Optional: GOOGLE_CREDENTIALS=credentials.json  GOOGLE_TOKEN=token.json (Desktop OAuth client)
